{
  "expo": {
    "name": "ThreePutt",
    "slug": "3putt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "threeputt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.benedwards44.3putt",
      "appleTeamId": "7466T7JYJN",
      "infoPlist": {
        "CFBundleDisplayName": "3 Putt"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#284828",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-android-app-name",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#284828",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
